# The .p8 MusicKit private key, base64 encoded into a single line:
#   base64 -i AuthKey_ABC1234567.p8 | tr -d '\n'
APPLE_MUSIC_PRIVATE_KEY_BASE64=

# The Key ID for that key. Ten uppercase alphanumeric characters.
APPLE_MUSIC_KEY_ID=

# Your Apple Developer Team ID. Ten uppercase alphanumeric characters.
APPLE_MUSIC_TEAM_ID=
